###########################################################################
#### Compute the FORWARD attributable fraction and number with uncertainty
datHere <- data.table(y=chicagoNMMAPS$cvd,temp0=chicagoNMMAPS$temp,date=chicagoNMMAPS$date)
for(i in 1:max_lag){
datHere[,paste("temp",i,sep="") :=temp0 ]
}
# now put in long format for gam() prediction

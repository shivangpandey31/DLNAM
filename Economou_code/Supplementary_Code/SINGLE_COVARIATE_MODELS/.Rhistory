library(readr)
# create the lag variable
longDat[,LAG := parse_number(as.character( variable ))]
names(longDat)[3] <- "TEMP"
longDat$W <- 1
X <- predict(gamDLNM,newdata=longDat,type="lpmatrix")
b <- rmvn(1000,gamDLNM$coefficients,gamDLNM$Vp)
logRR <- X[,-1] %*% t( b[,-1] )
## now center on OT
dum <- copy(longDat)
dum[,TEMP:=OT]
X_OT <- predict(gamDLNM,newdata=dum,type="lpmatrix")
logRR_OT <- X_OT[,-1] %*% t( b[,-1] )
longDat <- cbind( longDat,logRR - logRR_OT )
## now compute eq 6 of Gasp. and Leone (2014):
fAF <- longDat[,lapply(.SD,function(x){1-exp(-sum(x))}),by=date,.SDcols = V1:V1000]
## and merge with original data.table
datOrig <- data.table(y=chicagoNMMAPS$cvd,temp0=chicagoNMMAPS$temp,date=chicagoNMMAPS$date)
datOrig <- merge(datOrig,fAF,by="date")
## now compute fAN
fAN <- datOrig[,lapply(.SD,function(x){x*y}),.SDcols = V1:V1000]
# now totals (eq. 8a and 8b of Gasp. and Leone (2014))
ANtot <- apply(fAN,2,sum)
AFtot <- ANtot/sum(datOrig$y)
mean(AFtot)
quantile(AFtot,probs=c(0.025,0.975))
####################################################
### AF again but for cold/heat
thold <- quantile(datOrig$temp0,probs=0.95)
thold
fANhot <- datOrig[,lapply(.SD,function(x){x*y}),.SDcols = V1:V1000,by=temp0]
fANhot <- fANhot[temp0>thold,-"temp0"]
ANtot <- apply(fANhot,2,sum)
AFtot <- ANtot/sum(datOrig[temp0>thold]$y)
mean(AFtot)
quantile(AFtot,probs=c(0.025,0.975))
## cold
thold <- quantile(datOrig$temp0,probs=0.05)
thold
fANhot <- datOrig[,lapply(.SD,function(x){x*y}),.SDcols = V1:V1000,by=temp0]
fANhot <- fANhot[temp0<thold,-"temp0"]
ANtot <- apply(fANhot,2,sum)
AFtot <- ANtot/sum(datOrig[temp0<thold]$y)
mean(AFtot)
quantile(AFtot,probs=c(0.025,0.975))

## load R libraries
library(dlnm)
library(ggplot2)
library(viridis)
library(mgcv)
library(data.table)
library(plot3D)
library(readr)
## set as appropriate
plotDir <- getwd()
## The data set
head(chicagoNMMAPS)
## get cleaner version
dat <- data.table(y=chicagoNMMAPS$cvd,temp0=chicagoNMMAPS$temp)
dat
## Use the dlnm package to fit a Poisson DLNM
max_lag <- 20
vk <- quantile(dat$temp0,c(.1,.75,.9),na.rm=T)
lk <- logknots(max_lag,3)
cb1.temp <- crossbasis(dat$temp0, lag=max_lag, argvar=list(fun="ns", knots=vk), arglag=list(knots=lk))
# fit the model
model1 <- glm(y~cb1.temp,family=poisson(),data=dat)
# Compute the relative risk (RR) over a grid of temperature
# and lag values
temp_grid <- seq(-25,33,by=0.1)
lag_grid <- 0:max_lag
dlnm_grid <- data.table(expand.grid(temp_grid,lag_grid))
names(dlnm_grid) <- c("temp","lag")
# now predict the RR
pred1.temp <- crosspred(cb1.temp, model1, at=temp_grid, bylag=1, cumul=F, model.link = "log", cen=22)
dlnm_grid$RR <- as.vector(pred1.temp$matRRfit); range(dlnm_grid$RR)
## create custom colour scale for the plots
myBrks <- seq(0.90,1.385,by=0.001)
myColsFun <- colorRampPalette(c("darkblue","blue","white","red", "darkred"))
maxDev <- max( c(max(myBrks)-1,1-min(myBrks)) )
allBrks <- seq(1-maxDev,1+maxDev,by=0.001  )
Cols <- myColsFun(length(allBrks)-1)
ColsSub <- Cols[allBrks[-1] > min(myBrks)]
#####################################
par(mar=c(1,1.4,1,3))
persp3D(temp_grid, lag_grid, matrix(dlnm_grid$RR, length(temp_grid), length(lag_grid)),
theta = 220, phi = 20,ticktype = "detailed", xlab = "Temperature (\u00B0C)", ylab = "Lag (days)",
zlab = "RR", expand = 2/3,main="dlnm package", shade = 0.05,breaks = myBrks, col=ColsSub,
colkey = T,zlim=range(myBrks),cex.axis = 1.5,cex.lab=1.5)
###################################
###  Now fit as a GAM using mgcv
# need to create extra columns, one for each lag
n <- nrow(dat)
for(i in 1:max_lag){
dat[,paste("temp",i,sep="") := c(rep(NA,i),temp0[1:(n-i)]) ]
}
# set up the matrices required by gam()
index <- grep("temp", colnames(dat) )
tempDat <- na.omit( dat )
TEMP <- as.matrix( tempDat[,..index] )
LAG <- matrix(0:max_lag,nrow(TEMP),length(0:max_lag),byrow=TRUE)
W <- matrix(1,length(0:max_lag),nrow=nrow(LAG),ncol=ncol(LAG))
## gam with 10 knots for the lag dimension and 10 knots for temperature
gamDLNM <- gam(y~te(TEMP,LAG,by=W,k=c(10,10)),family=poisson,method="REML",data=tempDat)
## function to check if the maximum number of knots was adequate:
k.check(gamDLNM)
## 3D plot of RR
gam_grid <- data.table(expand.grid(temp_grid,lag_grid))
names(gam_grid) <- c("TEMP","LAG")
gam_grid$W <- 1
# model matrix without the intercept
X <- predict(gamDLNM,newdata=gam_grid,type="lpmatrix")[,-1]
# coefficients without the intercept
betas <- gamDLNM$coefficients[-1]
gam_grid$logRR <- X %*% betas
gam_grid[,RR:=exp(logRR)]
range(gam_grid$RR)
## Plot the estimated surface
par(mar=c(1,1.4,1,3))
persp3D(temp_grid, lag_grid, matrix(gam_grid$RR, length(temp_grid), length(lag_grid)),
theta = 220, phi = 20,ticktype = "detailed", xlab = "Temperature (\u00B0C)", ylab = "Lag (days)",
zlab = "RR", expand = 2/3,main="GAM-DLNM", shade = 0,breaks = myBrks, col=ColsSub,
colkey = T,zlim=range(myBrks),cex.axis = 1.5,cex.lab=1.5)
## Fit again but without penalisation
gamDLNM_unpenalised <- gam(y~te(TEMP,LAG,by=W,k=c(10,10),fx=T),family=poisson,method="REML",data=tempDat)
RRUnPen <- exp( ( predict(gamDLNM_unpenalised,newdata=gam_grid,type="lpmatrix")[,-1] %*% coef(gamDLNM_unpenalised)[-1] )[,1] )
# plot
par(mar=c(1,1.4,1,3))
persp3D(temp_grid, lag_grid, matrix(RRUnPen, length(temp_grid), length(lag_grid)),
theta = 220, phi = 20,ticktype = "detailed", xlab = "Temperature (\u00B0C)", ylab = "Lag (days)",
zlab = "RR", expand = 2/3,main="GAM-DLNM upenalised", shade = 0.05,breaks = myBrks, col=ColsSub,
colkey = F,zlim=range(myBrks),cex.axis = 1.5,cex.lab=1.5)
## Compute uncertainty in the estimates by posterior simulation of the coefficients
n.sims <- 1000
b <- rmvn(n.sims,coef(gamDLNM),gamDLNM$Vp)[,-1]
X <- predict(gamDLNM,newdata=gam_grid,type="lpmatrix")[,-1]
LP <- X %*% t(b)
# check if zero is in the credible interval (log-scale)
Lower <- apply(LP,1,quantile,probs=0.05)
Upper <- apply(LP,1,quantile,probs=0.95)
myDF <- data.frame(Upper,Lower)
test <- as.numeric(with(myDF,Upper>=0 & Lower<=0)) # is zero in the 95% CrI?
gam_grid$sign <- test
Sign <- gam_grid[sign==0]
# ggplot raster plot
myBrks2 <- seq(0.9,1.39,by=0.01)
RR_Sur <- ggplot(data=gam_grid) + geom_raster(aes(x=TEMP, y = LAG, fill=RR)) +
coord_fixed(ratio = 1.6) +
scale_fill_gradient2(limits=range(myBrks2),breaks=myBrks2,midpoint=1,high="darkred",low="darkblue") +
xlab("Temperature (\u00B0C)") +  ylab("Lag (days)") +
geom_point(data=Sign,aes(x=TEMP,y=LAG),alpha=0.05) + theme_bw() +
theme(axis.text=element_text(size=12),axis.title=element_text(size=14,face="bold"),legend.text=element_text(size=12),
legend.key.height = unit(2, 'cm'))
RR_Sur
##### Do the same, but center the risk on the optimum temperature
# sum over the lags to compute the cumulative risk in order to compute
# the optimum temperature
cumul_temp_raw <- gam_grid[,sum(logRR),by=TEMP]
# compute optimal temperature
OT <- cumul_temp_raw[which.min(V1),TEMP]
# exponentiate
cumul_temp_raw[,RR:=exp(V1)]
# compute credible intervals
logRRsims <- data.table(LP)
logRRsims[,TEMP:=gam_grid$TEMP]
cumul_temp_raw_sims <- logRRsims[,lapply(.SD, sum),.SDcols=V1:V1000,by=TEMP]
cumul_temp_raw$RR <-  apply( exp(cumul_temp_raw_sims[,-"TEMP"]),1,mean )
cumul_temp_raw$lower <-  apply( exp(cumul_temp_raw_sims[,-"TEMP"]),1,quantile,probs=0.025 )
cumul_temp_raw$upper <- apply( exp(cumul_temp_raw_sims[,-"TEMP"]),1,quantile,probs=0.975 )
## Use OT as the baseline risk rather than average mortality
gam_grid_baseline <- copy( gam_grid)
gam_grid_baseline$TEMP <- OT
gam_grid_baseline$logRR <- ( predict(gamDLNM,newdata=gam_grid_baseline,type="lpmatrix")[,-1] %*% coef(gamDLNM)[-1] )[,1]
gam_grid_baseline[,RR:=exp(logRR)]
## now compute the difference between the two risks
gam_grid_OT <- copy(gam_grid)
gam_grid_OT[,logRR := logRR - gam_grid_baseline$logRR ]
gam_grid_OT[,RR := exp(logRR) ]
# ggplot surface plot with uncertainty
LPbaseline <- predict(gamDLNM,newdata=gam_grid_baseline,type="lpmatrix")[,-1]%*%t(b)
LPcen <- LP - LPbaseline
Lower <- apply(LPcen,1,quantile,probs=0.05)
Upper <- apply(LPcen,1,quantile,probs=0.95)
myDF <- data.frame(Upper,Lower)
test <- as.numeric(with(myDF,Upper>=0 & Lower<=0)) # is zero in the 95% CrI?
Sign <- gam_grid_OT[test==0]
# ggplot surface plot
RR_Sur <- ggplot(data=gam_grid_OT) + geom_raster(aes(x=TEMP, y = LAG, fill=RR)) +
coord_fixed(ratio = 1.6) +
scale_fill_gradient2(limits=range(myBrks2),breaks=myBrks2,midpoint=1,high="darkred",low="darkblue") +
xlab("Temperature (\u00B0C)") +  ylab("Lag (days)") +
geom_point(data=Sign,aes(x=TEMP,y=LAG),alpha=0.05) + theme_bw() +
theme(axis.text=element_text(size=12),axis.title=element_text(size=14,face="bold"),legend.text=element_text(size=12),
legend.key.height = unit(2, 'cm'))
RR_Sur
#####
## Now compute the cumulative risk (CR)
# sum over the lags
cumul_temp_cen <- gam_grid_OT[,sum(logRR),by=TEMP]
cumul_temp_cen[,RR:=exp(V1)]
# and intervals
logRRsims <- data.table(LPcen)
logRRsims[,TEMP:=gam_grid$TEMP]
cumul_temp_cen_sims <- logRRsims[,lapply(.SD, sum),.SDcols=V1:V1000,by=TEMP]
cumul_temp_cen$lower <-  apply( exp(cumul_temp_cen_sims[,-"TEMP"]),1,quantile,probs=0.025 )
cumul_temp_cen$upper <-  apply( exp(cumul_temp_cen_sims[,-"TEMP"]),1,quantile,probs=0.975 )
## plot with intervals
cumul_temp_raw$whichOne <- "RR"
cumul_temp_cen$whichOne <- "RR centered on OT"
# for the rug
tempDat$whichOne <- "RR"
tempDat$RR <- 1
plotDat <- rbind(cumul_temp_raw,cumul_temp_cen)
theme_set(theme_minimal())
Cumul1 <- ggplot(data=plotDat,aes(x=TEMP,y=RR,fill=whichOne)) + geom_ribbon( aes(ymin = lower, ymax = upper, fill = whichOne),alpha=0.4) +
geom_line(aes(col=whichOne), size=1.3) +
theme(legend.position = c(0.15,0.85 ),legend.title=element_blank(),axis.text=element_text(size=12),axis.title=element_text(size=14,face="bold"),legend.text=element_text(size=12)) +
xlab("Apparent Temperature (\u00B0C)") + ylab("Cumulative Risk") + geom_vline(xintercept = OT,size=1.3) +
geom_rug(data=tempDat,mapping=aes(x=temp0,y=RR),col="black",alpha=0.1,sides="b")
Cumul1
### Now investigate the lag structure
tempQuantiles <- round( quantile(tempDat$temp0,probs=c(0.05,0.25,0.5,0.75,0.95)),1 )
gam_grid_OT$lower <- apply( exp(logRRsims[,1:1000]),1,quantile,probs=0.025)
gam_grid_OT$upper <- apply( exp(logRRsims[,1:1000]),1,quantile,probs=0.975)
gam_grid_OT[,TEMP:=round(TEMP,1)]
plotDatLags <- gam_grid_OT[TEMP%in%tempQuantiles]
plotDatLags[,Tmax:=factor(TEMP)]
Cumul2 <- ggplot(data=plotDatLags,aes(x=LAG,y=RR,col=Tmax)) +
geom_ribbon( aes(ymin = lower, ymax = upper, fill = Tmax),alpha=0.4) +
geom_line(aes(col=Tmax),size=1.3) +
theme(legend.position = c(1-0.15,1-0.87 ),axis.text=element_text(size=12),axis.title=element_text(size=14,face="bold"),legend.text=element_text(size=12)) +
xlab("Lag (days))") + ylab("Relative Risk")
Cumul2
###########################################################################
#### Compute the FORWARD attributable fraction and number with uncertainty
datHere <- data.table(y=chicagoNMMAPS$cvd,temp0=chicagoNMMAPS$temp,date=chicagoNMMAPS$date)
for(i in 1:max_lag){
datHere[,paste("temp",i,sep="") :=temp0 ]
}
# now put in long format for gam() prediction
longDat <- melt(datHere,id.vars="date",measure.vars = grep("temp", colnames(datHere) ))
# create the lag variable
longDat[,LAG := parse_number(as.character( variable ))]
names(longDat)[3] <- "TEMP"
longDat$W <- 1
X <- predict(gamDLNM,newdata=longDat,type="lpmatrix")
b <- rmvn(1000,gamDLNM$coefficients,gamDLNM$Vp)
logRR <- X[,-1] %*% t( b[,-1] )
## now center on OT
dum <- copy(longDat)
dum[,TEMP:=OT]
X_OT <- predict(gamDLNM,newdata=dum,type="lpmatrix")
logRR_OT <- X_OT[,-1] %*% t( b[,-1] )
longDat <- cbind( longDat,logRR - logRR_OT )
## now compute eq 6 of Gasp. and Leone (2014):
fAF <- longDat[,lapply(.SD,function(x){1-exp(-sum(x))}),by=date,.SDcols = V1:V1000]
## and merge with original data.table
datOrig <- data.table(y=chicagoNMMAPS$cvd,temp0=chicagoNMMAPS$temp,date=chicagoNMMAPS$date)
datOrig <- merge(datOrig,fAF,by="date")
## now compute fAN
fAN <- datOrig[,lapply(.SD,function(x){x*y}),.SDcols = V1:V1000]
# now totals (eq. 8a and 8b of Gasp. and Leone (2014))
ANtot <- apply(fAN,2,sum)
AFtot <- ANtot/sum(datOrig$y)
mean(AFtot)
quantile(AFtot,probs=c(0.025,0.975))
####################################################
### AF again but for cold/heat
thold <- quantile(datOrig$temp0,probs=0.95)
fANhot <- datOrig[,lapply(.SD,function(x){x*y}),.SDcols = V1:V1000,by=temp0]
fANhot <- fANhot[temp0>thold,-"temp0"]
ANtot <- apply(fANhot,2,sum)
AFtot <- ANtot/sum(datOrig[temp0>thold]$y)
mean(AFtot)
quantile(AFtot,probs=c(0.025,0.975))
## cold
thold <- quantile(datOrig$temp0,probs=0.05)
fANhot <- datOrig[,lapply(.SD,function(x){x*y}),.SDcols = V1:V1000,by=temp0]
fANhot <- fANhot[temp0<thold,-"temp0"]
ANtot <- apply(fANhot,2,sum)
AFtot <- ANtot/sum(datOrig[temp0<thold]$y)
mean(AFtot)
quantile(AFtot,probs=c(0.025,0.975))
